# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# QuickNode Solana DEVNET endpoint (faster + needed for Streams). Falls back to public devnet.
SOLANA_RPC_URL=
SOLANA_WS_URL=
# Gemini Prediction Markets SANDBOX keys only (api.sandbox.gemini.com)
GEMINI_SANDBOX_API_KEY=
GEMINI_SANDBOX_API_SECRET=

# QuickNode Stream webhook security token (Streams → destination → Security token)
QUICKNODE_STREAM_TOKEN=
